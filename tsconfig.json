{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./build",
    "module": "NodeNext",
    "target": "es2024",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build", "tests"]
}
